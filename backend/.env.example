DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/lab_agent?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 本文件仅作示例，应用只读取 backend/.env；不要在此填写真实密钥。
# 若密钥曾出现在示例或日志中，请先撤销并重新生成。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# 知识库默认关闭；嵌入模型使用硅基流动的 OpenAI 兼容接口。
RAG_ENABLED=false
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
# 如需使用百炼原生接口，将 provider 改为 dashscope，并修改模型和下列两项。
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_CANDIDATES=8
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.6
RAG_CONTEXT_CHARS=6000
