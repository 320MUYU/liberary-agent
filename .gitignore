# ================= Python / 后端 =================
# 虚拟环境：体积大、且能在别的电脑上重建，不要提交
.venv/
venv/
# Python 编译缓存
__pycache__/
*.py[cod]
*.egg-info/

# ================= 用户上传的文件 =================
# 运行时产物，且可能很大，不要提交
uploads/
backend/data/

# ================= 密钥与配置（重点！）=================
# .env 里有数据库密码和 JWT_SECRET_KEY，提交上去等于把钥匙公开
.env
.env.local
*.env
!*.env.example

